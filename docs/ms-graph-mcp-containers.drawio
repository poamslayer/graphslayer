    <mxGraphModel dx="1220" dy="1952" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#333333;" value="&lt;b&gt;ms-graph-mcp — Container diagram (C4 level 2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;An MCP server that reads Microsoft Graph through sandboxed scripts and writes through a separate, confirmed tool&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="900" x="60" y="-60" as="geometry" />
        </mxCell>
        <mxCell id="admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Adds connections and decides which tenants the agent can reach&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="70" y="50" as="geometry" />
        </mxCell>
        <mxCell id="agent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;AI agent / MCP client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Claude Code or any MCP host. Writes the JavaScript that reads Graph.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="300" x="440" y="50" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#666666;fontColor=#666666;verticalAlign=bottom;align=left;spacingLeft=16;spacingBottom=6;arcSize=2;" value="&lt;b&gt;ms-graph-mcp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Software System — one Node 22 process on the operator&#39;s machine]&lt;/font&gt;" vertex="1">
          <mxGeometry height="805" width="1160" x="30" y="215" as="geometry" />
        </mxCell>
        <mxCell id="cli" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: Node.js, src/cli]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;connect, connect --app-only, connections. Prompts for the credential, so it is never a tool argument.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="230" x="70" y="270" as="geometry" />
        </mxCell>
        <mxCell id="core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;MCP server core&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: TypeScript, MCP SDK over stdio]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Registers graph_describe, graph_run, graph_write and the connection tools. Resolves the tenant argument and caps every result.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="440" y="270" as="geometry" />
        </mxCell>
        <mxCell id="auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: MSAL Node]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Interactive sign-in and client credentials. The connection&#39;s cloud picks the authority.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="900" y="270" as="geometry" />
        </mxCell>
        <mxCell id="indexsandbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Index sandbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: workerd via Miniflare]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Built with no service binding, so it has no network at all. ADR-0008.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="230" x="70" y="480" as="geometry" />
        </mxCell>
        <mxCell id="sandbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Run sandbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: workerd via Miniflare]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Runs the agent&#39;s script in a fresh isolate. Its only reachable host is graph.local, behind a read-only binding. A timeout throws the runtime away.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="440" y="480" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;arcSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Graph client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Container: TypeScript, fetch]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Paging, retry on 429, 503 and 504, the ConsistencyLevel header, and one audit line per call. The only container that talks to Graph.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="440" y="700" as="geometry" />
        </mxCell>
        <mxCell id="gindex" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Graph index&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Data: JSON shipped with the package]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Paths, properties, default selects, least-privileged scopes, and the GCC High removals.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="70" y="700" as="geometry" />
        </mxCell>
        <mxCell id="connstore" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Connection store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Data: ~/.ms-graph-mcp/connections.json]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Alias, tenant, cloud, kind, mode, frozen scopes.&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="250" x="390" y="890" as="geometry" />
        </mxCell>
        <mxCell id="auditlog" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[Data: ~/.ms-graph-mcp/audit, 0700 and 0600]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;One line per call, run, write and connection change.&lt;/font&gt;" vertex="1">
