          </mxGeometry>
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;strokeColor=#CCCCCC;fillColor=none;spacing=10;" value="&lt;b&gt;Reading&lt;/b&gt; runs agent → graph_run → run sandbox → binding → Graph client → Graph. The script never holds a token and can reach no host but graph.local, and the sandbox is built without network for an index run.&lt;br&gt;&lt;b&gt;Writing&lt;/b&gt; skips the sandbox: graph_write previews the change, hands back a signed confirm token, and performs the write only for a connection whose mode is write.&lt;br&gt;&lt;b&gt;Clouds:&lt;/b&gt; each connection names its cloud, and that choice picks both the Graph endpoint and the sign-in authority. Tokens are not interchangeable between clouds." vertex="1">
          <mxGeometry height="80" width="1470" x="30" y="1050" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
